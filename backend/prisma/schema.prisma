generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMINISTRATOR
  TEACHER
  STUDENT
}

enum AcademicPeriod {
  ANNUAL
  FIRST_SEMESTER
  SECOND_SEMESTER
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  passwordHash   String?
  name           String
  role           UserRole         @default(STUDENT)
  student        Student?
  taughtCourses  CourseOffering[] @relation("CourseTeacher")
  recordedGrades Grade[]          @relation("GradeRecordedBy")
  deletedGrades  Grade[]          @relation("GradeDeletedBy")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Student {
  id          String       @id @default(uuid())
  userId      String       @unique
  studentCode String       @unique
  firstName   String
  lastName    String
  phone       String?
  birthDate   DateTime?
  address     String?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Subject {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  credits     Int
  isActive    Boolean          @default(true)
  offerings   CourseOffering[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model CourseOffering {
  id          String         @id @default(uuid())
  subjectId   String
  teacherId   String?
  year        Int
  period      AcademicPeriod
  section     String         @default("A")
  capacity    Int
  enrolled    Int            @default(0)
  classroom   String?
  schedule    String?
  isActive    Boolean        @default(true)
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher     User?          @relation("CourseTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([subjectId, year, period, section])
  @@index([year, period])
}

model Enrollment {
  id               String         @id @default(uuid())
  studentId        String
  courseOfferingId String
  enrolledAt       DateTime       @default(now())
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  grades           Grade[]

  @@unique([studentId, courseOfferingId])
  @@index([courseOfferingId])
}

model Grade {
  id           String     @id @default(uuid())
  enrollmentId String
  title        String
  score        Float
  weight       Int
  comment      String?
  recordedById String?
  deletedById  String?
  deletedAt    DateTime?
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  recordedBy   User?      @relation("GradeRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  deletedBy    User?      @relation("GradeDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([enrollmentId, deletedAt])
}
